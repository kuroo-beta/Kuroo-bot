TOKEN=
BOT_NAME=Kuroo
# Optional Discord bot username; blank leaves the current name unchanged.
BOT_DISPLAY_NAME=ⓀⓊⓇⓄⓄ
STREAMING_NAME=Kuroo Music
# Twitch channel used by the streaming presence (canonical form of m.twitch.tv/discord/home).
STREAMING_URL=https://www.twitch.tv/discord
PREFIX=?
SHARD_COUNT=1
DEVELOPER_IDS=
REPORT_CHANNEL=0
MONGO_URI=mongodb://localhost:27017
MONGO_NAME=kuroo
# Sync application emojis before commands load (requires a valid bot token).
SYNC_EMOJIS=True
DASHBOARD_ENABLED=True
WEB_HOST=0.0.0.0
WEB_PORT=25572
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DASHBOARD_SECRET=
DASHBOARD_BASE_URL=http://localhost:25572
GUILD_JOIN_WEBHOOK=
GUILD_LEAVE_WEBHOOK=
SHARDS_LOG_WEBHOOK=

# Optional public links
WEBSITE=https://github.com/amonwashere-lotm/Kuroo
SUPPORT_SERVER=https://github.com/amonwashere-lotm/Kuroo/issues
VOTE_URL=

# Top.gg v1: configure https://your-host/webhooks/topgg on the Top.gg dashboard.
# Copy its whs_... signing secret here; never commit the populated .env.
TOPGG_WEBHOOK_SECRET=

# Optional: override the uploaded Discord bot banner shown above help pages.
BOT_BANNER_URL=
